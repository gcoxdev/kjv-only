/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.tile.openstreetmap.org https://tile.openstreetmap.org https://a.tile.opentopomap.org; font-src 'self'; connect-src 'self' https://tiles.openfreemap.org https://a.tile.opentopomap.org https://photon.komoot.io; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Cross-Origin-Opener-Policy: same-origin

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/sw.js
  Cache-Control: no-cache

/app-cache-config.js
  Cache-Control: no-cache

/app-shell-assets.json
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/
  Cache-Control: no-cache

/data/*
  Cache-Control: no-cache

/references/*
  Cache-Control: no-cache

/maps/data/*
  Cache-Control: no-cache

/topics/*
  Cache-Control: no-cache

/theme-init.js
  Cache-Control: no-cache
